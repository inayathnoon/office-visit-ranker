# Normalise on checkin and check out LF everywhere. Without this a clone on
# Windows rewrites every file to CRLF and `ruff format --check` fails in CI
# on a diff nobody wrote.
* text=auto eol=lf

*.png binary
*.jpg binary
*.parquet binary

# Generated by `uv lock`, not written by hand. Collapsing it in diffs keeps a
# dependency bump reviewable, and excluding it from the language stats stops
# a large TOML file from deciding what GitHub calls this repo.
uv.lock linguist-generated=true -diff

# Charts are build output committed for the README, not source to review.
docs/img/** linguist-generated=true
