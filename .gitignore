# Anchored to the repo root: an unanchored directory rule matches at every
# depth and will happily exclude a source package of the same name.
/data/
/out/
/mlruns/
/models/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
.env

# Test and build output
.coverage
coverage.xml
htmlcov/
/dist/
/build/
*.egg-info/

# Editors and notebooks
.idea/
.vscode/
.ipynb_checkpoints/

# Secrets: .env is already ignored, but the per-profile variants are the ones
# that actually get created and forgotten about.
.env.*
!.env.example
